import sys


def get_budget(args):
    if len(args) < 2:
        print("初期予算を引数で指定してください", file=sys.stderr)
        int("error")
    return float(args[1])


remain = get_budget(sys.argv)
has_input = 0

for line in sys.stdin:
    expense = float(line)
    remain = remain - expense
    print(remain)
    has_input = 1

if has_input == 0:
    print("出費データがありません", file=sys.stderr)
    int("error")
